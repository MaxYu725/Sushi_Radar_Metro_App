* text=auto

# Keep CI, Gradle and web source deterministic across Windows and Linux.
gradlew text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.kt text eol=lf
*.kts text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.xml text eol=lf
*.sql text eol=lf

*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
